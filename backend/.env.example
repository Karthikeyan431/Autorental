# ARMS backend configuration. Every setting the app reads is listed here (a test checks this).
# Copy to backend/.env for local use; scripts\db-setup.ps1 writes a ready-made development
# backend/.env with random passwords and keys. NEVER commit a real .env.

# development | test | production. Production refuses to start with unsafe settings.
APP_ENV=development

# Runtime connection as app_user (least privilege).
DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5432/arms_dev
# Migrations run as app_owner, which owns the schema.
MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:change-me@localhost:5432/arms_dev
# Test suite only. Database names must end in _test; the tests rebuild this schema.
TEST_DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5432/arms_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:change-me@localhost:5432/arms_test

# Signing key for tokens (Week 2). Random, at least 32 characters.
SECRET_KEY=change-me
# AES-256-GCM key for encrypted fields (licence numbers, drivers' addresses and dates of birth,
# the licence date of birth, the owner's TOTP secret): base64 of 32 random bytes. Back it up
# separately from the database backups: losing it makes those fields unreadable.
FIELD_ENCRYPTION_KEY=change-me
# Short id stored with each encrypted value, so the key can be rotated later.
FIELD_ENCRYPTION_KEY_ID=f1
# AES-256-GCM keys for documents on disk, as key_id:base64 pairs, comma separated (rotation).
FILE_ENCRYPTION_KEYS=change-me
# The key_id used for new documents; must be one of FILE_ENCRYPTION_KEYS.
ACTIVE_FILE_KEY_ID=k1
# HMAC key for licence-number duplicate checks (Week 3): base64 of 32 random bytes.
# NEVER change it once drivers exist, and back it up with the other keys: losing or changing it
# breaks duplicate detection for every stored licence number.
LOOKUP_HMAC_KEY=change-me

# Where encrypted documents are stored, outside the web root. Default: <repo>/data/files.
DOCUMENTS_DIR=
# UIDAI Secure QR signing certificate (docs/kyc.md). Not used until the in-app decoder is built,
# after the legal adviser answers N13 (D48). Leave empty.
UIDAI_CERT_PATH=

# Feature flags. In-app Aadhaar QR scanning stays off until N13 is answered.
AADHAAR_QR_INAPP_ENABLED=false
# UIDAI app attestation by staff ("Checked by staff with the UIDAI app", D47). Off until the
# legal adviser answers N13; read at startup. Set true in development to try it.
AADHAAR_APP_ATTEST_ENABLED=false
# Demo verifier for development and tests only. Production refuses to start when true.
DEMO_VERIFIER_ENABLED=false

# Sign-in throttle per IP address: this many failed sign-ins within the window gives 429.
LOGIN_IP_MAX_FAILURES=20
LOGIN_IP_WINDOW_MINUTES=15

# Development seed only (scripts\seed.ps1): the password for the fake owner and 2 staff.
# At least 10 characters and not a common password. Leave empty here; never commit a value.
SEED_DEV_PASSWORD=

# The browser origin allowed by CORS. Empty disables CORS (same origin through Vite or Caddy).
CORS_ORIGIN=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
