# PLACEHOLDER (Week 8). Runs the idempotent jobs once; started by arms-jobs.timer.
# The job modules are added in later weeks (accrual: Week 5, pay requests: Week 6, alerts: Week 7).
[Unit]
Description=ARMS scheduled jobs (rent accrual, pay requests, alerts)
After=postgresql.service

[Service]
Type=oneshot
User=arms
Group=arms
WorkingDirectory=/srv/arms/app/backend
EnvironmentFile=/etc/arms/arms.env
ExecStart=/srv/arms/venv/bin/python -m app.jobs.run_all
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/arms/data
